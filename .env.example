# Market Reader environment variables
# Copy to apps/web/.env.local and fill in what you have. Restart `npm run dev` after changes.
#
# PUBLIC  = starts with NEXT_PUBLIC_, is sent to the browser. Safe to expose.
# SECRET  = server only. Never commit it, never prefix it with NEXT_PUBLIC_, never put it in the mobile app.
#
# Everything is optional: missing market-data keys fall back to clearly labelled demo prices,
# missing Supabase keys turn accounts off, missing Stripe keys turn payments off.

# ---------- App ----------
# PUBLIC. Your site's address, used for Stripe return links. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to run entirely on made-up demo prices (no internet needed for market data)
MARKET_READER_DEMO=false

# ---------- Supabase (auth, watchlists, portfolio) ----------
# Supabase dashboard > Project Settings > API
# PUBLIC. Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC. The "anon" / publishable key. Row-level security keeps each user's data private.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The "service_role" key. Bypasses row-level security; used only by the Stripe webhook and AI usage counter.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe (subscription tiers) ----------
# Stripe dashboard > Developers > API keys. Test keys only (sk_test_..., pk_test_...): this class project refuses live keys.
# PUBLIC. Not needed for the current redirect-to-Checkout flow; reserved for Stripe.js elements later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SECRET. sk_test_... (live keys are rejected)
STRIPE_SECRET_KEY=
# SECRET. Only needed when Supabase accounts are on. Signing secret for /api/stripe/webhook (whsec_...), from `stripe listen` locally or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=
# Optional. Price id of a $20/month recurring price (price_...). Leave blank and the app creates the $20/month price itself.
STRIPE_PRICE_PRO=

# ---------- Market data ----------
# SECRET. US quotes, company profiles, news, earnings. Free key: https://finnhub.io/register
FINNHUB_API_KEY=
# SECRET. US stock and ETF price history. Free key: https://massive.com (formerly Polygon.io)
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com
# SECRET. Optional: raises CoinGecko's crypto limits. Free Demo key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# SECRET. US stock and ETF history for the 5Y and MAX charts (back to 1962, adjusted for splits and dividends).
# Free key: https://www.tiingo.com (sign up, then Account > API > Token). Without it those charts show Massive's ~2 years.
TIINGO_API_KEY=
# Crypto 5Y/MAX charts use Kraken's public data: free, no key.
# Forex uses Frankfurter (ECB reference rates, back to 1999): free, no key.

# ---------- AI assistant ----------
# SECRET. https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_SUMMARY_MODEL=claude-haiku-4-5-20251001
# Pro users' assistant can also search the web (extra cost per search). Set to false to turn off.
AI_WEB_SEARCH=true

# Class project: free market-data tiers are for personal, non-commercial use, which fits a classroom demo.
